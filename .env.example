# Copy to .env and fill in what you use. Nothing is required for the offline default.
RAG_EMBEDDER=tfidf                # tfidf | sentence-transformers
RAG_LLM_BACKEND=extractive        # extractive | anthropic | openai
RAG_INDEX_DIR=index
RAG_CHUNK_SIZE=180
RAG_CHUNK_OVERLAP=40
RAG_TOP_K=5

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
